    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "postcss": "8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "3.4.19",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
